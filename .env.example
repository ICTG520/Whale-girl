# NoneBot
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8090
LOG_LEVEL=INFO
COMMAND_START=["/"]
NICKNAME=["鲸鱼娘"]

# OneBot v11
ONEBOT_V11_ACCESS_TOKEN=change-me-to-a-random-token

# Whale-girl
AGENT_NAME=鲸鱼娘
QQ_GROUP_WHITELIST=[]
QQ_FRIEND_WHITELIST=[]
WAKE_WORDS=["鲸鱼娘"]
OBSERVE_ALL_GROUP_MESSAGES=true
REPLY_ENABLED=true

# DeepSeek (OpenAI-compatible)
# 只在本机 .env 的 DEEPSEEK_API_KEY 后填写真实 Key，切勿提交。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Reply generation
REPLY_MODE=ai
AI_FALLBACK_TO_FIXED=true
AI_MAX_CONTEXT_MESSAGES=12
AI_MAX_CONTEXT_CHARS=6000
AI_MAX_INPUT_CHARS=2000
AI_MAX_REPLY_CHARS=600
AI_MAX_OUTPUT_TOKENS=300
AI_TEMPERATURE=0.8
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_COOLDOWN_SECONDS=2
AI_MAX_CALLS_PER_MINUTE=10
AI_MAX_CALLS_PER_DAY=200

# Group AI (M4)
AI_GROUP_ENABLED=true
AI_GROUP_FALLBACK_TO_FIXED=false
AI_GROUP_MAX_CONTEXT_MESSAGES=20
AI_GROUP_COOLDOWN_SECONDS=30
AI_GROUP_MAX_CALLS_PER_MINUTE=6
AI_GROUP_MAX_CALLS_PER_DAY=100

# Local persona file
PERSONA_PATH=config/persona.toml

# SQLite storage
DATABASE_PATH=data/whale_girl.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
